# =====================================================================
#  Fiber Link Notificações - arquivo de configuração de exemplo
# ---------------------------------------------------------------------
#  NÃO edite este arquivo para produção. O instalador (deploy/install.sh)
#  gera automaticamente /var/www/fiberlink-notificacoes/shared/.env
#  com todas as chaves e senhas aleatórias. Nunca envie o .env ao Git.
# =====================================================================

APP_NAME="Fiber Link Notificações"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://painel.minhafiberlink.com.br
API_URL=https://api.minhafiberlink.com.br
APP_TIMEZONE=America/Sao_Paulo

# Gerados automaticamente pelo instalador (32+ bytes aleatórios cada)
APP_KEY=
JWT_SECRET=
WEBHOOK_SECRET=
INTERNAL_API_SECRET=

# Banco de dados (MariaDB local, usuário exclusivo da aplicação)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fiberlink_notifications
DB_USERNAME=fiberlink
DB_PASSWORD=

# Redis (somente localhost, com senha). Deixe REDIS_HOST vazio para usar locks no banco.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=fiberlink:

# Caminho de dados persistentes (logs, sessões, status). Em produção é um link
# simbólico para /var/www/fiberlink-notificacoes/shared/storage
STORAGE_PATH=

# Sessão do painel
SESSION_LIFETIME_MINUTES=120

# Retenção de backups (usada por deploy/backup.sh)
BACKUP_DIR=/var/backups/fiberlink
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3
BACKUP_KEEP_SAFETY=5

# Releases mantidas em /var/www/fiberlink-notificacoes/releases
KEEP_RELEASES=5
