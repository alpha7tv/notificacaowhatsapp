# Uploads são só imagens: nada aqui pode ser executado.
<FilesMatch "\.(?i:php\d*|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php5 .php7 .php8
Options -ExecCGI -Indexes
